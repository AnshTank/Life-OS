datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // For credentials auth
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model JournalBook {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  ownerName   String
  bookType    String         @default("journal")
  color       String         @default("#7a9eb8")
  purpose     String?
  description String?
  icon        String?
  isPrivate   Boolean        @default(false)
  tags        String[]
  coverImage  String?
  startedAt   DateTime       @default(now())
  chapters    String[]
  createdAt   DateTime       @default(now())
  entries     JournalEntry[]
}

model JournalEntry {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  title     String
  content   String
  mood      String?
  chapter   String?
  tags      String[]
  bookId    String      @db.ObjectId
  book      JournalBook @relation(fields: [bookId], references: [id])
  date      DateTime    @default(now())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Task {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  userId           String
  title            String
  description      String?
  lifeArea         String    @default("career")
  goalId           String?
  impact           Int       @default(5)
  urgency          Int       @default(5)
  effort           Int       @default(5)
  priorityScore    Float     @default(5.0)
  dueDate          DateTime?
  scheduledFor     DateTime?
  reminderAt       DateTime?
  status           String    @default("todo")
  completedAt      DateTime?
  isRecurring      Boolean   @default(false)
  recurringPattern String?
  tags             String[]
  sharedWithPartner Boolean  @default(false)
  partnerId        String?   @db.ObjectId
  partner          Partner?  @relation("PartnerTasks", fields: [partnerId], references: [id])
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, status])
  @@index([userId, lifeArea])
  @@index([userId, dueDate])
  @@index([priorityScore])
}

model Habit {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  userId        String
  title         String
  description   String?
  lifeArea      String         @default("health")
  frequency     String         @default("daily") // 'daily', 'weekly', 'monthly'
  targetDays    Int            @default(7)
  streak        Int            @default(0)
  longestStreak Int            @default(0)
  color         String         @default("#3b82f6")
  icon          String         @default("activity")
  reminderTime  String?

  // Quantifiable habit fields
  habitType     String         @default("boolean") // 'boolean' | 'quantifiable'
  targetValue   Int?           // e.g., 10 (glasses of water)
  unit          String?        // e.g., 'glass', 'step', 'page', 'minute', 'km', 'rep'
  unitIcon      String?        // e.g., 'glass', 'bottle', 'footprints'

  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  checkins      HabitCheckin[]

  @@index([userId, lifeArea])
  @@index([userId, frequency])
}

model HabitCheckin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  habitId   String   @db.ObjectId
  date      DateTime
  note      String?
  value     Int      @default(1) // For quantifiable habits: how many units in this check-in

  createdAt DateTime @default(now())

  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([habitId])
  @@index([habitId, date])
}

model Goal {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  userId            String
  title             String
  description       String?
  lifeArea          String      @default("career")
  category          String      @default("short-term") // 'short-term', 'long-term', 'habit-based'
  targetDate        DateTime?
  status            String      @default("active") // 'active', 'completed', 'paused', 'archived'
  impact            Int         @default(5)
  progress          Int         @default(0) // 0-100
  sharedWithPartner Boolean     @default(false)
  partnerId         String?     @db.ObjectId
  partner           Partner?    @relation("PartnerGoals", fields: [partnerId], references: [id])
  aiQuote           String?

  deletedAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  milestones        Milestone[] // Relation to milestones

  @@index([userId, status])
  @@index([userId, lifeArea])
}

model Milestone {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  goalId      String    @db.ObjectId
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?

  createdAt   DateTime  @default(now())

  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model AiCache {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  cacheKey  String   @unique
  summary   String
  link      String?
  type      String   @default("holiday")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([cacheKey, expiresAt])
}

// Partner model (enhanced)
model Partner {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @default("user-1")
  linkedUserId String?
  name        String
  description String?
  email       String?
  phone       String?
  website     String?
  avatar      String?
  company     String?
  role        String?    // e.g., "CEO", "Manager", "Developer"
  address     String?
  tags        String[]
  partnerType String?    // "strategic", "vendor", "client", "affiliate", "personal"
  status      String     @default("active") // "active", "inactive", "archived"
  priority    String     @default("medium") // "high", "medium", "low"
  socialLinks Json?      // { linkedin, twitter, github, etc. }
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  projects    Project[]      @relation("PartnerProjects")
  goals       Goal[]         @relation("PartnerGoals")
  tasks       Task[]         @relation("PartnerTasks")
  notes       PartnerNote[]  @relation("PartnerNotes")

  @@index([userId])
  @@index([status])
  @@index([partnerType])
}

model PartnerNote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  partnerId String   @db.ObjectId
  title     String
  content   String
  noteType  String   @default("general") // "general", "meeting", "call", "email", "follow-up"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner   Partner  @relation("PartnerNotes", fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

model Project {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String
  title String
  description String
  type String @default("personal")
  status String @default("planning")
  techStack String[]
  startDate DateTime?
  targetDate DateTime?
  completedDate DateTime?
  progress Int @default(0)
  hoursSpent Float @default(0)
  earnings Float?
  clientName String?
  repositoryUrl String?
  demoUrl String?
  notes String[]
  tasks Json
  partnerId String? @db.ObjectId
  partner Partner? @relation("PartnerProjects", fields: [partnerId], references: [id])
  slug String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Engineering Suite relations
  engineeringNotes Note[] @relation("ProjectNotes")
  meetings         Meeting[] @relation("ProjectMeetings")
  mistakes         Mistake[] @relation("ProjectMistakes")
  requirements     RequirementDoc[] @relation("ProjectRequirements")
  testCases        TestCase[] @relation("ProjectTestCases")
  visualDiffs      VisualDiff[] @relation("ProjectVisualDiffs")

  @@index([userId, status])
  @@index([userId, type])
  @@index([userId, slug])
  @@index([userId, targetDate])
}

model Investment {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String
  name           String
  symbol         String?
  type           String   // 'stock' | 'mutual_fund' | 'etf' | 'crypto' | 'bond' | 'fd' | 'sip'
  quantity       Float
  averagePrice   Float
  currentPrice   Float
  investedAmount Float
  currentValue   Float
  pnl            Float
  pnlPercent     Float
  sector         String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, type])
}

model Transaction {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String
  type        String   // 'income' | 'expense'
  category    String
  amount      Float
  description String
  date        DateTime @default(now())
  tags        String[]
  createdAt   DateTime @default(now())

  @@index([userId, type])
  @@index([userId, category])
  @@index([userId, date])
}

model Budget {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  category  String
  limit     Float
  spent     Float    @default(0)
  period    String   @default("monthly") // 'monthly' | 'yearly'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, category])
}

model EMI {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String
  name           String
  principal      Float
  interestRate   Float
  tenureMonths   Int
  emiAmount      Float
  startDate      DateTime
  endDate        DateTime
  totalInterest  Float
  totalAmount    Float
  paidMonths     Int      @default(0)
  remainingMonths Int
  status         String   @default("active") // 'active' | 'completed'
  createdAt      DateTime @default(now())

  @@index([userId, status])
}

model SIP {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String
  name           String
  amount         Float
  frequency      String   @default("monthly") // 'monthly' | 'weekly' | 'daily'
  startDate      DateTime
  expectedReturn Float
  tenureYears    Int
  totalInvested  Float    @default(0)
  projectedValue Float
  status         String   @default("active") // 'active' | 'paused' | 'stopped'
  createdAt      DateTime @default(now())

  @@index([userId, status])
}

model SavingsGoal {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  userId              String
  name                String
  targetAmount        Float
  currentSaved        Float     @default(0)
  deadline            DateTime?
  priority            String    @default("medium") // 'high' | 'medium' | 'low'
  color               String    @default("#7a9eb8")
  icon                String?
  monthlySavingTarget Float?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId, priority])
}

model Subscription {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String
  name            String
  amount          Float
  frequency       String   @default("monthly") // 'monthly' | 'yearly' | 'weekly'
  category        String
  startDate       DateTime
  nextBillingDate DateTime
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())

  @@index([userId, isActive])
}

model PurchaseLog {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String
  name               String
  amount             Float
  date               DateTime @default(now())
  category           String
  satisfactionRating Int      @default(5) // 1-5
  notes              String?
  createdAt          DateTime @default(now())

  @@index([userId, category])
}

model Note {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  projectId String?  @db.ObjectId
  project   Project? @relation("ProjectNotes", fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  content   String
  folder    String   @default("All") // All, Meetings, Work, Personal, Trash
  section   String?
  tags      String[]
  backlinks String[] // Titles or IDs of linked notes
  isFav     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, projectId])
  @@index([folder])
}

model Meeting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String
  projectId   String?  @db.ObjectId
  project     Project? @relation("ProjectMeetings", fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  transcript  String?
  summary     String?
  decisions   String?  // JSON string
  actionItems String?  // JSON string
  risks       String?  // JSON string
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, projectId])
}

model Mistake {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String
  projectId          String?  @db.ObjectId
  project            Project? @relation("ProjectMistakes", fields: [projectId], references: [id], onDelete: Cascade)
  title              String
  description        String
  rootCause          String
  severity           String   @default("medium") // low, medium, high, critical
  category           String   @default("technical") // requirement, testing, deployment, communication, technical
  preventionStrategy String
  createdAt          DateTime @default(now())

  @@index([userId, projectId])
}

model RequirementDoc {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  userId          String
  projectId       String?    @db.ObjectId
  project         Project?   @relation("ProjectRequirements", fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  laymanText      String
  functionalSpecs String?    // JSON string
  technicalSpecs  String?    // JSON string
  createdAt       DateTime   @default(now())
  testCases       TestCase[]

  @@index([userId, projectId])
}

model TestCase {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  userId         String
  projectId      String?         @db.ObjectId
  project        Project?        @relation("ProjectTestCases", fields: [projectId], references: [id], onDelete: Cascade)
  requirementId  String?         @db.ObjectId
  requirement    RequirementDoc? @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  steps          String[]
  expectedResult String
  status         String          @default("pending") // pending, pass, fail
  testType       String          @default("functional") // functional, api, regression, performance, security, edge-case
  createdAt      DateTime        @default(now())

  @@index([userId, projectId])
}

model VisualDiff {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String
  projectId       String?  @db.ObjectId
  project         Project? @relation("ProjectVisualDiffs", fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  beforeImage     String   // Base64 or URL
  afterImage      String   // Base64 or URL
  diffImage       String?  // Base64 or URL
  detectedChanges String?  // JSON string
  createdAt       DateTime @default(now())

  @@index([userId, projectId])
}

model Conversation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  title     String
  messages  Json     // Array of { role: String, content: String, timestamp: String }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}